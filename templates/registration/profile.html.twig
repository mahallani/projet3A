{% extends 'base.html.twig' %}

{% block title %}Mon Profil{% endblock %}

{% block body %}
    <div class="container my-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card shadow-lg">
                    <div class="card-header bg-primary text-white text-center py-4">
                        <h1 class="h3 mb-0">Mon Profil</h1>
                        <p class="mb-0 text-white">Bienvenue, {{ app.user.prenom }} !</p>
                    </div>
                    <div class="card-body p-4">
                        <!-- Profile Dropdown -->
                        <div class="profile-dropdown text-end mb-4">
                            <button class="btn btn-secondary dropdown-toggle" type="button" id="profileDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-user-circle me-2"></i> Profil
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profileDropdown">
                                <li><a class="dropdown-item" href="{{ path('app_profile') }}"><i class="fas fa-edit me-2"></i> Modifier</a></li>
                                <li><a class="dropdown-item" href="{{ path('app_logout') }}"><i class="fas fa-sign-out-alt me-2"></i> Déconnexion</a></li>
                            </ul>
                        </div>

                        <!-- Profile Information -->
                        <div class="card mb-4">
                            <div class="card-body">
                                <h4 class="card-title">{{ app.user.nom }} {{ app.user.prenom }}</h4>
                                <hr>
                                <p class="card-text"><strong><i class="fas fa-envelope me-2"></i> Email:</strong> {{ app.user.email }}</p>
                                <p class="card-text"><strong><i class="fas fa-phone me-2"></i> Téléphone:</strong> {{ app.user.numtel }}</p>
                                <p class="card-text"><strong><i class="fas fa-globe me-2"></i> Nationalité:</strong> {{ app.user.Nationnalite }}</p>
                            </div>
                        </div>

                        <!-- Delete Account Button -->
                        <div class="text-center mt-4">
                            <a href="{{ path('app_user_delete') }}" class="btn btn-danger">
                                <i class="fas fa-trash-alt me-2"></i> Supprimer mon compte
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
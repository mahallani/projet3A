{% extends 'back.html.twig' %}

{% block title %}Articles{% endblock %}

{% block body %}
    <h1>Articles</h1>
    
    {# Formulaire de recherche #}
    <form method="get" action="{{ path('app_article_search') }}" class="mb-3">
        <div class="input-group">
            <input type="number" name="id" class="form-control" value="{{ searchId|default('') }}" placeholder="Search by ID">
            <div class="input-group-append">
                <button type="submit" class="btn btn-primary">{{ 'Search'|trans }}</button>
            </div>
        </div>
    </form>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Titre</th>
                <th>Contenu</th>
                <th>Date de l'article</th>
                <th>Galerie</th>
                <th>Nbrevue</th>
                <th>Nbrelike</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for article in pagination.items %}
            <tr>
                <td>{{ article.id }}</td>
                <td>{{ article.titre }}</td>
                <td>{{ article.contenu }}</td>
                <td>{{ article.datearticle ? article.datearticle|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ article.galerie }}</td>
                <td>{{ article.nbrevue }}</td>
                <td>{{ article.nbrelike }}</td>
                <td>
                    <a href="{{ path('app_article_show', {'id': article.id}) }}">Détails |</a>
                    <a href="{{ path('app_article_edit', {'id': article.id}) }}">Modifier |</a>
                    <a href="{{ path('app_article_pdf', {'id': article.id}) }}">PDF</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">Aucun article trouvé.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center mt-4">
        <div>
            {{ knp_pagination_render(pagination) }}
        </div>

        {# Formulaire pour "Jump to page" #}
        <div>
            <form class="form-inline" method="get" action="{{ path(app.request.attributes.get('_route')) }}">
                
                <label for="jump-to-page" class="mr-2">{{ 'Jump to page'|trans }}</label>
                <input type="number" id="jump-to-page" name="page" min="1" 
                       max="{{ (pagination.getTotalItemCount() // pagination.getItemNumberPerPage()) + 1 }}" 
                       class="form-control" placeholder="{{ 'Page number'|trans }}" style="width: 100px;">
                <button type="submit" class="btn btn-primary ml-2">{{ 'Go'|trans }}</button>
            </form>
        </div>
    </div>

    <a href="{{ path('app_article_new') }}">Ajouter un nouvel article</a>
{% endblock %}

{% extends 'back.html.twig' %}

{% block title %}Articles{% endblock %}

{% block body %}
    <h1>Articles </h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Titre</th>
                <th>Contenu</th>
                <th>Datearticle</th>
                <th>Galerie</th>
                <th>Nbrevue</th>
                <th>Nbrelike</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for article in articles %}
            <tr>
                <td>{{ article.id }}</td>
                <td>{{ article.titre }}</td>
                <td>{{ article.contenu }}</td>
                <td>{{ article.datearticle ? article.datearticle|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ article.galerie }}</td>
                <td>{{ article.nbrevue }}</td>
                <td>{{ article.nbrelike }}</td>
                <td>
                    <a href="{{ path('app_article_show', {'id': article.id}) }}">Details |</a>
                    <a href="{{ path('app_article_edit', {'id': article.id}) }}">Modifier </a>
                    
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_article_new') }}">Ajouter nouveau article</a>
{% endblock %}

{% extends 'base1.html.twig' %}

{% block title %}Edit User{% endblock %}

{% block body %}
  <main id="main" class="main">
    <div class="pagetitle">
      <h1>Edit User</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="{{ path('app_admin_index') }}">Home</a></li>
          <li class="breadcrumb-item"><a href="{{ path('app_admin_index') }}">Users</a></li>
          <li class="breadcrumb-item active">Edit User</li>
        </ol>
      </nav>
    </div><!-- End Page Title -->

    <section class="section">
      <div class="row">
        <div class="col-lg-12">
          <div class="card">
            <div class="card-body">
              <h5 class="card-title">Edit User Information</h5>

              {{ form_start(form, {'attr': {'class': 'row g-3 needs-validation', 'novalidate': 'novalidate'}}) }}

                <!-- First Name -->
                <div class="col-md-6">
                  {{ form_label(form.nom, 'First Name', {'label_attr': {'class': 'form-label'}}) }}
                  {{ form_widget(form.nom, {'attr': {'class': 'form-control', 'placeholder': 'Enter first name'}}) }}
                  <div class="invalid-feedback">
                    Please provide a valid first name.
                  </div>
                </div>

                <!-- Last Name -->
                <div class="col-md-6">
                  {{ form_label(form.prenom, 'Last Name', {'label_attr': {'class': 'form-label'}}) }}
                  {{ form_widget(form.prenom, {'attr': {'class': 'form-control', 'placeholder': 'Enter last name'}}) }}
                  <div class="invalid-feedback">
                    Please provide a valid last name.
                  </div>
                </div>

          

                <!-- Phone Number -->
                <div class="col-md-6">
                  {{ form_label(form.numtel, 'Phone Number', {'label_attr': {'class': 'form-label'}}) }}
                  {{ form_widget(form.numtel, {'attr': {'class': 'form-control', 'placeholder': 'Enter phone number'}}) }}
                  <div class="invalid-feedback">
                    Please provide a valid phone number.
                  </div>
                </div>

          

                <!-- Submit Button -->
                <div class="text-center mt-4">
                  <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save me-2"></i> Save Changes
                  </button>
                  <a href="{{ path('app_admin_index') }}" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-2"></i> Cancel
                  </a>
                </div>

              {{ form_end(form) }}
            </div>
          </div>
        </div>
      </div>
    </section>
  </main><!-- End #main -->
{% endblock %}
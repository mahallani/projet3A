<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User List PDF</title>
  <style>
    body {
      font-family: Arial, sans-serif;
    }
    h1 {
      text-align: center;
      color: #333;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
    }
    table, th, td {
      border: 1px solid #ddd;
    }
    th, td {
      padding: 8px;
      text-align: left;
    }
    th {
      background-color: #f2f2f2;
      color: #333;
    }
    tr:nth-child(even) {
      background-color: #f9f9f9;
    }
    .badge {
      padding: 4px 8px;
      border-radius: 4px;
      font-size: 12px;
      font-weight: bold;
    }
    .bg-success {
      background-color: #28a745;
      color: white;
    }
    .bg-warning {
      background-color: #ffc107;
      color: black;
    }
    .bg-danger {
      background-color: #dc3545;
      color: white;
    }
  </style>
</head>
<body>
  <h1>User List</h1>
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Email</th>
        <th>Phone</th>
        <th>Nationality</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      {% for user in users %}
        <tr>
          <td>{{ user.id }}</td>
          <td>{{ user.nom }} {{ user.prenom }}</td>
          <td>{{ user.email }}</td>
          <td>{{ user.numtel }}</td>
          <td>{{ user.Nationnalite }}</td>
          <td>
            {% if user.isVerified %}
              <span class="badge bg-success">Verified</span>
            {% else %}
              <span class="badge bg-warning">Not Verified</span>
            {% endif %}
            {% if user.isBanned %}
              <span class="badge bg-danger">Banned</span>
            {% endif %}
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="6" class="text-center">No users found.</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</body>
</html>
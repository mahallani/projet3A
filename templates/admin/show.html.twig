{% extends 'base1.html.twig' %}

{% block title %}User Details{% endblock %}

{% block body %}
  <main id="main" class="main">
    <div class="pagetitle">
      <h1>User Details</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="{{ path('app_admin_index') }}">Home</a></li>
          <li class="breadcrumb-item"><a href="{{ path('app_admin_index') }}">Users</a></li>
          <li class="breadcrumb-item active">User Details</li>
        </ol>
      </nav>
    </div><!-- End Page Title -->

    <section class="section">
      <div class="row">
        <div class="col-lg-12">
          <div class="card">
            <div class="card-body">
              <h5 class="card-title">User Information</h5>

              <div class="row">
                <!-- User Details -->
                <div class="col-md-6">
                  <ul class="list-group list-group-flush">
                    <li class="list-group-item">
                      <strong>ID:</strong> {{ user.id }}
                    </li>
                    <li class="list-group-item">
                      <strong>First Name:</strong> {{ user.nom }}
                    </li>
                    <li class="list-group-item">
                      <strong>Last Name:</strong> {{ user.prenom }}
                    </li>
                    <li class="list-group-item">
                      <strong>Email:</strong> {{ user.email }}
                    </li>
                    <li class="list-group-item">
                      <strong>Phone Number:</strong> {{ user.numtel }}
                    </li>
                    <li class="list-group-item">
                      <strong>Nationality:</strong> {{ user.Nationnalite }}
                    </li>
                  </ul>
                </div>

                <!-- User Status -->
                <div class="col-md-6">
                  <ul class="list-group list-group-flush">
                    <li class="list-group-item">
                      <strong>Status:</strong>
                      {% if user.isVerified %}
                        <span class="badge bg-success">Verified</span>
                      {% else %}
                        <span class="badge bg-warning">Not Verified</span>
                      {% endif %}
                    </li>
                    <li class="list-group-item">
                      <strong>Ban Status:</strong>
                      {% if user.isBanned %}
                        <span class="badge bg-danger">Banned</span>
                      {% else %}
                        <span class="badge bg-success">Active</span>
                      {% endif %}
                    </li>
                  </ul>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="text-center mt-4">
                <a href="{{ path('app_admin_edit', {'id': user.id}) }}" class="btn btn-warning">
                  <i class="bi bi-pencil me-2"></i> Edit
                </a>
                <a href="{{ path('app_admin_index') }}" class="btn btn-secondary">
                  <i class="bi bi-arrow-left me-2"></i> Back to List
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main><!-- End #main -->
{% endblock %}
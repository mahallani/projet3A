<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    
    <title>{% block title %}BabySteps{% endblock %}</title>

    <link rel="icon" href="{{ asset('assets/frontoffice/img/babyconn.png') }}">
    <link href="https://fonts.googleapis.com/css?family=Poppins:200i,300,300i,400,400i,500,500i,600,600i,700,700i,800,800i,900,900i&display=swap" rel="stylesheet">

    {% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/frontoffice/css/bootstrap.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/frontoffice/css/nice-select.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/frontoffice/css/font-awesome.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/frontoffice/css/icofont.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/frontoffice/css/slicknav.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/frontoffice/css/owl-carousel.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/frontoffice/css/datepicker.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/frontoffice/css/animate.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/frontoffice/css/magnific-popup.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/frontoffice/css/normalize.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/frontoffice/style.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/frontoffice/css/responsive.css') }}">
    {% endblock %}
</head>

<body>

    <!-- Preloader -->
   <!-- <div class="preloader">
        <div class="loader">
            <div class="loader-outter"></div>
            <div class="loader-inner"></div>
            <div class="indicator">
                <svg width="16px" height="12px">
                    <polyline id="back" points="1 6 4 6 6 11 10 1 12 6 15 6"></polyline>
                    <polyline id="front" points="1 6 4 6 6 11 10 1 12 6 15 6"></polyline>
                </svg>
            </div>
        </div>
    </div> -->
    <!-- End Preloader -->

    <!-- Header -->
    <header class="header">
        <div class="topbar">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-6 col-md-5 col-12">
                        <ul class="top-link">
                            <li><a href="#">About</a></li>
                            <li><a href="#">Doctors</a></li>
                            <li><a href="#">Contact</a></li>
                            <li><a href="#">FAQ</a></li>
                        </ul>
                    </div>
                    <div class="col-lg-6 col-md-7 col-12 d-flex justify-content-end align-items-center">
                        <ul class="top-contact">
                            <li><i class="fa fa-phone"></i> 71 000 000</li>
                            <li><i class="fa fa-envelope"></i><a href="mailto:BabySteps@gmail.com">BabySteps@gmail.com</a></li>
                        </ul>
                        <div class="top-buttons ml-auto">
                            <a href="#" class="btn">Sign In</a>
                            <a href="#" class="btn primary">Sign Up</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Navigation -->
        <div class="header-inner">
            <div class="container">
                <div class="inner">
                    <div class="row">
                        <div class="col-12">
                            <div class="main-menu">
                                <nav class="navigation">
                                    <ul class="nav menu">
                                        <img src="{{ asset('assets/frontoffice/img/logoo1.png') }}" alt="#" width="100" height="100">
                                        <li class="active"><a href="#">Home</a></li>
                                        <li><a href="#">Doctors</a></li>
                                        <li><a href="#">Medical Record</a></li>
                                        <li><a href="#">Blog & Advice</a></li>
                                        <li><a href="#">Get Appointment</a></li>
                                        <li><a href="#">Prescription</a></li>
                                        <li><a href="#">Room Reservation</a></li>
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>
    <!-- End Header -->

    <!-- Contenu dynamique -->
    <main style="display: flex; flex-direction: column; justify-content: center; align-items: center; height: 100vh; text-align: center;">
        <div style="width: 80%; max-width: 800px; padding: 20px; background: #f9f9f9; box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1); border-radius: 10px;">
            {% block main %}{% endblock %}
        </div>
    </main>

    <!-- Footer -->
    <footer id="footer" class="footer">
        <div class="footer-top">
            <div class="container">
                <div class="row">
                    <div class="col-lg-3 col-md-6 col-12">
                        <div class="single-footer">
                            <h2>About Us</h2>
                            <p>We provide expert maternity care with compassion and professionalism.</p>
                            <ul class="social">
                                <li><a href="#"><i class="icofont-facebook"></i></a></li>
                                <li><a href="#"><i class="icofont-twitter"></i></a></li>
                                <li><a href="#"><i class="icofont-google-plus"></i></a></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-9 col-12">
                        <div class="single-footer f-link">
                            <h2>Quick Links</h2>
                            <ul>
                                <li><a href="#">Home</a></li>
                                <li><a href="#">About Us</a></li>
                                <li><a href="#">FAQ</a></li>
                                <li><a href="#">Contact Us</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="copyright">
            <div class="container text-center">
                <p>&copy; 2025 BabySteps. All rights reserved.</p>
            </div>
        </div>
    </footer>
    <!-- End Footer -->

    {% block javascripts %}
    <script src="{{ asset('assets/frontoffice/js/jquery.min.js') }}"></script>
    <script src="{{ asset('assets/frontoffice/js/bootstrap.min.js') }}"></script>
    <script src="{{ asset('assets/frontoffice/js/main.js') }}"></script>
    {% endblock %}
</body>
</html>

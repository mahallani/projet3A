<form method="post" action="{{ path('app_ordonnance_delete', {'id': ordonnance.id}) }}" onsubmit="return confirm('{{ 'Are you sure you want to delete this item?'|trans }}');" class="flex-grow-1">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ ordonnance.id) }}">
    <button type="submit" class="btn btn-danger btn-sm w-100">{{ 'Delete'|trans }}</button>
</form>
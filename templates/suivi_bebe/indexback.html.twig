{% extends 'base1.html.twig' %}

{% block title %}Liste Suivi Bébé{% endblock %}

{% block body %}
  <main id="main" class="main">
    <div class="pagetitle">
      <h1>Liste Suivi Bébé</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="{{ path('app_admin_index') }}">Accueil</a></li>
          <li class="breadcrumb-item active">Suivi Bébé</li>
        </ol>
      </nav>
    </div><!-- End Page Title -->

    <section class="section">
      <div class="row">
        <div class="col-lg-12">
          <div class="card">
            <div class="card-body">
              <h5 class="card-title">Liste des Suivis Bébé</h5>

              <!-- Search Bar -->
              <form class="search-form d-flex align-items-center mb-3" method="GET" action="{{ path('app_suivi_bebe_index') }}">
                <input type="text" name="search" class="form-control" placeholder="Rechercher un suivi bébé..." value="{{ app.request.query.get('search') }}">
                <button type="submit" class="btn btn-primary ms-2"><i class="bi bi-search"></i></button>
              </form>

              <!-- Suivi Bébé Table -->
              <table class="table table-striped">
                <thead>
                  <tr>
                    <th>ID</th>
                    <th>Suivi Grossesse ID</th>
                    <th>Date de Suivi</th>
                    <th>Poids Bébé</th>
                    <th>Taille Bébé</th>
                    <th>État de Santé</th>
                    <th>Appétit Bébé</th>
                    <th>Battement du Cœur</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {% for suivi_bebe in suivi_bebes %}
                    <tr>
                      <td>{{ suivi_bebe.id }}</td>
                      <td>{{ suivi_bebe.suiviGrossesse.id }}</td>
                      <td>{{ suivi_bebe.dateSuivi ? suivi_bebe.dateSuivi|date('Y-m-d H:i') : 'Non défini' }}</td>
                      <td>{{ suivi_bebe.poidsBebe }}</td>
                      <td>{{ suivi_bebe.tailleBebe }}</td>
                      <td>{{ suivi_bebe.etatSante }}</td>
                      <td>{{ suivi_bebe.appetitBebe }}</td>
                      <td>{{ suivi_bebe.battementCoeur }}</td>
                      <td class="action-buttons">
                        <!-- Edit Button -->
                        <a href="{{ path('app_suivi_bebe_edit', {'id': suivi_bebe.id}) }}" class="btn btn-sm btn-warning" title="Modifier">
                          <i class="bi bi-pencil"></i>
                        </a>

                        <!-- Delete Button with Confirmation Modal -->
                        <form action="{{ path('app_suivi_bebe_delete', {'id': suivi_bebe.id}) }}" method="POST" class="d-inline" onsubmit="return confirm('Voulez-vous vraiment supprimer ce suivi bébé ?');">
                          <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ suivi_bebe.id) }}">
                          <button type="submit" class="btn btn-sm btn-danger" title="Supprimer">
                            <i class="bi bi-trash"></i>
                          </button>
                        </form>
                      </td>
                    </tr>
                  {% else %}
                    <tr>
                      <td colspan="9" class="text-center">Aucun suivi bébé trouvé.</td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>

              <!-- Redirection Buttons -->
              <div class="text-end mt-3">
                {% if suivi_grossesse is defined and suivi_grossesse.id is not null %}
                  <a href="{{ path('app_suivi_bebe_new', {'suiviGrossesseId': suivi_grossesse.id}) }}" class="btn btn-success me-2">
                    <i class="bi bi-plus-circle"></i> Ajouter un suivi bébé
                  </a>
                {% endif %}
                <a href="{{ path('app_admin_index') }}" class="btn btn-secondary">
                  <i class="bi bi-arrow-left"></i> Retour au tableau de bord
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main><!-- End #main -->
{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    /* Custom Styles */
    .title-list {
      text-align: center;
      font-family: 'Montserrat', sans-serif;
      font-size: 36px;
      color: #007bff;
      margin-bottom: 40px;
      font-weight: 600;
      text-transform: uppercase;
    }

    .table {
      width: 100%;
      border-collapse: collapse;
      margin: 0 auto;
      background-color: #ffffff;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 8px 15px rgba(0, 0, 0, 0.1);
    }

    .table th, .table td {
      padding: 15px;
      text-align: center;
      font-family: 'Roboto', sans-serif;
      font-size: 16px;
      border-bottom: 1px solid #e0e0e0;
    }

    .table th {
      background-color: #007bff;
      color: white;
      font-weight: bold;
      text-transform: uppercase;
    }

    .table tr:nth-child(even) {
      background-color: #f4f7fb;
    }

    .table tr:hover {
      background-color: #eaf1ff;
    }

    .action-buttons .btn {
      margin: 2px;
      font-size: 14px;
    }

    .btn-success, .btn-secondary {
      transition: transform 0.3s, background-color 0.3s;
    }

    .btn-success:hover, .btn-secondary:hover {
      transform: translateY(-2px);
    }

    .no-records {
      text-align: center;
      font-size: 16px;
      color: #999;
      font-style: italic;
    }
  </style>
{% endblock %}
{% extends 'base1.html.twig' %}

{% block title %}Delete SuiviBebe{% endblock %}

{% block main %}
    <h1>Delete SuiviBebe</h1>

    <!-- Formulaire de suppression avec le token CSRF -->
   <form action="{{ path('app_suivi_bebe_delete', {'id': suivi_bebe.id}) }}" method="POST" style="display:inline;" onsubmit="return confirm('Voulez-vous vraiment supprimer ce suivi bébé ?');">
    {{ csrf_token('delete' ~ suivi_bebe.id) }}
    <button type="submit" class="btn btn-danger">Supprimer</button>
</form>


    <script>
        // Fonction de confirmation de suppression
        function confirmDelete() {
            return confirm("Êtes-vous sûr de vouloir supprimer ce suivi de bébé ?");
        }
    </script>
{% endblock %}

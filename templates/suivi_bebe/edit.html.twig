{% extends 'base1.html.twig' %}

{% block title %}Edit SuiviBebe{% endblock %}

{% block body %}
  <main id="main" class="main">
    <div class="pagetitle">
      <h1>Modifier Suivi Bébé</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="{{ path('app_admin_index') }}">Accueil</a></li>
          <li class="breadcrumb-item"><a href="{{ path('app_suivi_bebe_indexback', {'suiviGrossesseId': suivi_bebe.suiviGrossesse.id}) }}">Liste des Suivis Bébé</a></li>
          <li class="breadcrumb-item active">Modifier</li>
        </ol>
      </nav>
    </div><!-- End Page Title -->

    <section class="section">
      <div class="row">
        <div class="col-lg-12">
          <div class="card">
            <div class="card-body">
              <h5 class="card-title">Modifier les détails du suivi bébé</h5>

              <!-- Include the Form -->
              {{ include('suivi_bebe/_form.html.twig', {'button_label': 'Mettre à jour'}) }}

              <!-- Redirection Buttons -->
              <div class="text-end mt-3">
                <a href="{{ path('app_suivi_bebe_indexback', {'suiviGrossesseId': suivi_bebe.suiviGrossesse.id}) }}" class="btn btn-secondary me-2">
                  <i class="bi bi-arrow-left"></i> Retour à la liste
                </a>
                {{ include('suivi_bebe/_delete_form.html.twig') }}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main><!-- End #main -->
{% endblock %}


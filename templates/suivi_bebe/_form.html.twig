<style>
    /* Conteneur principal du formulaire */
    .form-container {
        max-width: 600px;
        margin: 50px auto;
        padding: 30px;
        background-color: #ffffff; /* Fond blanc */
        border-radius: 10px;
        box-shadow: 0 8px 15px rgba(0, 0, 0, 0.1); /* Ombre douce */
        border: 1px solid #e0e0e0; /* Bordure gris clair */
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; /* Police moderne */
    }

    /* En-tête du formulaire */
    .form-container h2 {
        text-align: center;
        font-size: 24px;
        color: #007bff; /* Bleu pour le titre */
        margin-bottom: 20px;
        font-family: 'Arial', sans-serif;
    }

    /* Groupes de champs de formulaire */
    .form-group {
        margin-bottom: 20px;
        padding: 15px;
        background-color: #f9f9f9; /* Fond léger gris */
        border-radius: 8px;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05); /* Ombre légère */
    }

    /* Labels des champs */
    .form-label {
        display: block;
        font-weight: bold;
        margin-bottom: 8px;
        color: #333;
        font-size: 16px;
        font-family: 'Arial', sans-serif;
    }

    /* Champs de saisie (inputs, textarea, etc.) */
    .form-input, .form-control {
        width: 100%;
        padding: 12px;
        font-size: 16px;
        border: 1px solid #ccc;
        border-radius: 8px;
        background-color: #f4f7fb; /* Fond bleu clair */
        transition: border-color 0.3s ease, background-color 0.3s ease;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* Focus sur les champs */
    .form-input:focus, .form-control:focus {
        border-color: #007bff; /* Bleu pour le focus */
        background-color: #eaf1ff; /* Légère teinte bleue */
        outline: none;
    }

    /* Bouton de soumission */
    .btn-submit {
        display: inline-block;
        padding: 12px 25px;
        background-color: #007bff; /* Bleu */
        color: white;
        font-size: 18px;
        border: none;
        border-radius: 30px; /* Bord arrondi */
        cursor: pointer;
        transition: background-color 0.3s ease, transform 0.2s ease;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* Effet au survol du bouton */
    .btn-submit:hover {
        background-color: #0056b3; /* Bleu plus foncé */
        transform: translateY(-2px); /* Effet de soulèvement */
    }

    /* Erreurs de validation */
    .form-error {
        color: #ff4d4d;
        font-size: 14px;
        margin-top: 5px;
        font-family: 'Arial', sans-serif;
    }

    /* Groupes d'input (applicable pour les champs comme poids) */
    .input-group {
        display: flex;
        align-items: center;
    }

    .input-group .input-group-text {
        background-color: #007bff;
        color: white;
        font-weight: bold;
        padding: 10px;
        border-radius: 4px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .input-group .form-control {
        border-radius: 4px 0 0 4px;
    }
    /* Titre centré avec une police différente et couleur bleue */
.form-container h2 {
    text-align: center;
    font-size: 30px; /* Taille du titre */
    color: #007bff; /* Bleu */
    margin-bottom: 30px;
    font-family: 'Verdana', sans-serif; /* Police différente */
}

/* Centrer le bouton de soumission */
.btn-submit {
    display: block;
    width: 200px;
    margin: 30px auto; /* Centrer le bouton */
    padding: 12px 25px;
    background-color: #007bff;
    color: white;
    font-size: 18px;
    border: none;
    border-radius: 30px;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.2s ease;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}
/* Centrer le bouton de soumission */
.btn-submit {
    display: block;
    width: 200px;
    margin: 30px auto; /* Centrer le bouton */
    padding: 12px 25px;
    background-color: #007bff;
    color: white;
    font-size: 18px;
    border: none;
    border-radius: 30px;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.2s ease;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}
 /* Lien pour la liste des suivis bébé */
    .link-container {
        text-align: center;
        margin-top: 20px;
    }
</style>

{{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
<div class="form-container">

    <h2>Suivi de Bebe</h2>
    <div class="form-group">
        {{ form_label(form.date_suivi, 'Date de suivi') }}
        {{ form_widget(form.date_suivi, {'attr': {'class': 'form-input', 'type': 'datetime-local'}}) }}
        <div class="form-error">{{ form_errors(form.date_suivi) }}</div>
    </div>

    <div class="form-group">
        {{ form_label(form.poids_bebe, 'Poids du bébé') }}
        {{ form_widget(form.poids_bebe, {'attr': {'class': 'form-input', 'type': 'number', 'step': '0.01'}}) }}
        <div class="form-error">{{ form_errors(form.poids_bebe) }}</div>
    </div>

    <div class="form-group">
        {{ form_label(form.taille_bebe, 'Taille du bébé') }}
        {{ form_widget(form.taille_bebe, {'attr': {'class': 'form-input', 'type': 'number', 'step': '0.1'}}) }}
        <div class="form-error">{{ form_errors(form.taille_bebe) }}</div>
    </div>

    <div class="form-group">
        {{ form_label(form.etat_sante, 'État de santé') }}
        {{ form_widget(form.etat_sante, {'attr': {'class': 'form-input'}}) }}
        <div class="form-error">{{ form_errors(form.etat_sante) }}</div>
    </div>

    <div class="form-group">
        {{ form_label(form.appetit_bebe, 'Appétit du bébé') }}
        {{ form_widget(form.appetit_bebe, {'attr': {'class': 'form-input'}}) }}
        {{ form_errors(form.appetit_bebe) }}
    </div>

    <div class="form-group">
        {{ form_label(form.battement_coeur, 'Battements du cœur') }}
        {{ form_widget(form.battement_coeur, {'attr': {'class': 'form-input', 'type': 'number', 'step': '1'}}) }}
        <div class="form-error">{{ form_errors(form.battement_coeur) }}</div>
    </div>

<button class="btn-submit">{{ button_label|default('Enregistrer') }}</button> <!-- Bouton centré -->
 <!-- Lien vers la liste des suivis bébé -->
    
</div>
{{ form_end(form) }}

<form method="post" action="{{ path('app_traitement_delete', {'id': traitement.id}) }}" onsubmit="return confirm('{{ 'Are you sure you want to delete this item?'|trans }}');" class="flex-grow-1">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ traitement.id) }}">
    <button type="submit" class="btn btn-danger w-100">{{ 'Delete'|trans }}</button>
</form>